# Telegram API credentials
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Your phone number with country code (e.g., +12345678900)
TELEGRAM_PHONE=your_phone_number
# Telegram channel to listen to (e.g., @channelname)
TELEGRAM_CHANNEL_TO_LISTEN=channel_username_or_id

# Setup configuration (JSON stringified)
SETUP_CONFIG={"buy_conditions": ["buy", "long", "bullish"], "sell_conditions": ["sell", "short", "bearish"]}

# Symbol mapping configuration (JSON stringified)
# position_type can be "once" or "each"
# interval_minutes is used when position_type is "each"
# position_sl can be "no_sl", "signal_sl", or "user_sl"
# stop_loss is used when position_sl is "user_sl" (percentage as decimal)
CONFIGURATION={"mappings": [{"from_message": ["BTC", "Bitcoin"], "mapping": "BTCUSDT"}, {"from_message": ["ETH", "Ethereum"], "mapping": "ETHUSDT"}], "position_type": "once", "interval_minutes": 0, "position_sl": "no_sl"}

# Example with user-defined stop loss:
# CONFIGURATION={"mappings": [{"from_message": ["BTC", "Bitcoin"], "mapping": "BTCUSDT"}], "position_type": "once", "interval_minutes": 0, "position_sl": "user_sl", "stop_loss": 5.0} 