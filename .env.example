# Telegram API credentials
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Your phone number with country code (e.g., +12345678900)
TELEGRAM_PHONE=your_phone_number
# Telegram channel to listen to (e.g., @channelname)
TELEGRAM_CHANNEL_TO_LISTEN=channel_username_or_id

# Configuration (JSON stringified)
# buy_conditions: list of keywords that indicate a buy signal
# sell_conditions: list of keywords that indicate a sell signal
# pair_mappings: maps trading pair mentions in messages to actual trading symbols
# sl_mappings: maps stop loss mentions in messages using same structure
#   - sl_position: can be "before" or "after" to indicate where the SL value appears relative to the mapping keyword
# tp_mappings: maps take profit mentions in messages using same structure
#   - tp_position: can be "before" or "after" to indicate where the TP value appears relative to the mapping keyword
# position_type can be:
#   - "once": Trigger a position only once per detected signal (default)
#   - "each": Trigger a position at regular intervals defined by interval_minutes
#   - "tp_length": Create as many positions as there are take profit levels in the signal (TP1, TP2, etc.)
# interval_minutes is used when position_type is "each"
# position_sl can be "no_sl", "signal_sl", or "user_sl"
# position_tp can be "no_tp", "signal_tp", "user_tp", or "alternate"
# When position_type is "each" and position_tp is "alternate", the system will alternate between take profit levels for each position
# stop_loss is used when position_sl is "user_sl" (percentage as decimal)
# take_profit is used when position_tp is "user_tp" (percentage as decimal)
CONFIGURATION={"buy_conditions": ["buy", "long", "bullish"], "sell_conditions": ["sell", "short", "bearish"], "pair_mappings": [{"from_message": ["BTC", "Bitcoin"], "mapping": "BTCUSDT"}, {"from_message": ["ETH", "Ethereum"], "mapping": "ETHUSDT"}], "sl_mappings": [], "tp_mappings": [], "position_type": "once", "interval_minutes": 0, "position_sl": "no_sl", "position_tp": "no_tp"}

# Example with signal-based stop loss and take profit:
# CONFIGURATION={"buy_conditions": ["buy", "long"], "sell_conditions": ["sell", "short"], "pair_mappings": [{"from_message": ["BTC", "Bitcoin"], "mapping": "BTCUSDT"}], "sl_mappings": [{"from_message": ["sl", "stop loss"], "mapping": "sl", "sl_position": "after"}], "tp_mappings": [{"from_message": ["tp", "take profit"], "mapping": "tp", "tp_position": "after"}], "position_type": "once", "interval_minutes": 0, "position_sl": "signal_sl", "position_tp": "signal_tp"}

# Example with user-defined stop loss and take profit:
# CONFIGURATION={"buy_conditions": ["buy", "long"], "sell_conditions": ["sell", "short"], "pair_mappings": [{"from_message": ["BTC", "Bitcoin"], "mapping": "BTCUSDT"}], "sl_mappings": [{"from_message": ["stop"], "mapping": "sl", "sl_position": "before"}], "tp_mappings": [{"from_message": ["target", "tp"], "mapping": "tp", "tp_position": "before"}], "position_type": "once", "interval_minutes": 0, "position_sl": "user_sl", "position_tp": "user_tp", "stop_loss": 5.0, "take_profit": 10.0}

# Example with multiple take profit levels (TP1, TP2, etc.):
# CONFIGURATION={"buy_conditions": ["buy", "long"], "sell_conditions": ["sell", "short"], "pair_mappings": [{"from_message": ["BTC", "Bitcoin"], "mapping": "BTCUSDT"}], "sl_mappings": [{"from_message": ["sl"], "mapping": "sl", "sl_position": "after"}], "tp_mappings": [{"from_message": ["tp"], "mapping": "tp", "tp_position": "after"}], "position_type": "tp_length", "position_sl": "signal_sl", "position_tp": "signal_tp"}

# Example with alternating take profit levels for each position:
# CONFIGURATION={"buy_conditions": ["buy", "long"], "sell_conditions": ["sell", "short"], "pair_mappings": [{"from_message": ["BTC", "Bitcoin"], "mapping": "BTCUSDT"}], "sl_mappings": [{"from_message": ["sl"], "mapping": "sl", "sl_position": "after"}], "tp_mappings": [{"from_message": ["tp"], "mapping": "tp", "tp_position": "after"}], "position_type": "each", "interval_minutes": 30, "position_sl": "signal_sl", "position_tp": "alternate"} 